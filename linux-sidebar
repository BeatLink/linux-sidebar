#!/usr/bin/env python3
"""Starts the sidebar, with the package beside this script on the import path."""

import os
import sys

import gi

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

from linux_sidebar.app import main

if __name__ == "__main__":
    sys.exit(main())
